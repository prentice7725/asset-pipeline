{
  "type": "object",
  "properties": {
    "style_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "output_class": {
      "enum": [
        "PIXEL_STATIC",
        "PIXEL_ANIMATION",
        "NONPIXEL_IMAGE",
        "NONPIXEL_ANIMATION",
        "SFX"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "PROMPT",
            "REFERENCE_IMAGE",
            "DOCUMENTS"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "paths",
        "references"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "canonical_traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "canonical_traits",
        "visual_traits"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "transparency": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "silhouette": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "resolution",
        "transparency",
        "palette",
        "silhouette",
        "style"
      ],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_target": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "motion_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "action",
        "frame_target",
        "motion_constraints"
      ],
      "additionalProperties": false
    },
    "workflow_preferences": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_profile": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preset": {
          "type": "string"
        },
        "allow_experimental": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "forbidden_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unspecified_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "classification": {
            "enum": [
              "EXPLICIT",
              "DERIVED",
              "UNSPECIFIED"
            ]
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "classification",
          "text",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "prompt": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "prompt_spec": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "pose": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        },
        "appearance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "style": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "textInImage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "styleSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "description"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "properties": {
        "static_master": {
          "type": "string"
        },
        "approval_record": {
          "type": "string"
        },
        "motion_reference": {
          "type": "string"
        },
        "source_frames": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "direct_profile": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "asset_id",
    "asset_type",
    "output_class",
    "purpose",
    "source",
    "identity",
    "constraints",
    "animation",
    "workflow_preferences",
    "forbidden_elements",
    "unspecified_elements",
    "source_notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
