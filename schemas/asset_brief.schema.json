{
  "type": "object",
  "properties": {
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "authority",
        "source",
        "primary_focus"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "authority": {
          "const": "EXPLICIT_BRIEF"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "primary_focus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "style_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "output_class": {
      "enum": [
        "PIXEL_STATIC",
        "PIXEL_ANIMATION",
        "NONPIXEL_IMAGE",
        "NONPIXEL_ANIMATION",
        "SFX"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "PROMPT",
            "REFERENCE_IMAGE",
            "DOCUMENTS"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "paths",
        "references"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "canonical_traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "canonical_traits",
        "visual_traits"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "transparency": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "silhouette": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "resolution",
        "transparency",
        "palette",
        "silhouette",
        "style"
      ],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_target": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "motion_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "action",
        "frame_target",
        "motion_constraints"
      ],
      "additionalProperties": false
    },
    "workflow_preferences": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_profile": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preset": {
          "type": "string"
        },
        "allow_experimental": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "forbidden_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unspecified_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "classification": {
            "enum": [
              "EXPLICIT",
              "DERIVED",
              "UNSPECIFIED"
            ]
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "classification",
          "text",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "prompt": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "prompt_spec": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject"
      ],
      "properties": {
        "subject_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "identity_source"
          ],
          "properties": {
            "class": {
              "enum": [
                "full_character",
                "costume_item",
                "prop",
                "environment"
              ]
            },
            "identity_source": {
              "type": "string",
              "minLength": 1
            },
            "whole_subject_required": {
              "type": "boolean"
            },
            "physically_connected_body": {
              "type": "boolean"
            },
            "mandatory_parts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "camera_view": {
              "enum": [
                "from_source",
                "front",
                "rear",
                "left",
                "right"
              ]
            },
            "equipment": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_trait",
                  "relationship"
                ],
                "properties": {
                  "source_trait": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relationship": {
                    "enum": [
                      "worn",
                      "carried"
                    ]
                  },
                  "visible_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "location": {
                    "enum": [
                      "unspecified",
                      "front",
                      "rear",
                      "left",
                      "right"
                    ]
                  }
                }
              }
            },
            "forbidden_substitutions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "art_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focal_target",
            "source"
          ],
          "properties": {
            "focal_target": {
              "enum": [
                "full_character",
                "costume_item",
                "prop",
                "environment"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "style_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "value_grouping": {
              "const": "large_coherent_masses"
            },
            "shadow_grouping": {
              "const": "broad_connected_shadows"
            },
            "background_texture": {
              "const": "subordinate"
            },
            "subject_texture": {
              "const": "selective_detail"
            },
            "silhouette_contrast": {
              "const": "strong"
            },
            "preserve_scene_landmarks": {
              "const": true
            }
          }
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "pose": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        },
        "appearance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "style": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "textInImage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "styleSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "description"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "properties": {
        "static_master": {
          "type": "string"
        },
        "approval_record": {
          "type": "string"
        },
        "motion_reference": {
          "type": "string"
        },
        "source_frames": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "direct_profile": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "asset_id",
    "asset_type",
    "output_class",
    "purpose",
    "source",
    "identity",
    "constraints",
    "animation",
    "workflow_preferences",
    "forbidden_elements",
    "unspecified_elements",
    "source_notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
