{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "FACTORY_IDENTITY_VARIANT_JOB"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "base": {
      "type": "object",
      "properties": {
        "manifest_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "selected_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "manifest_ref",
        "manifest_sha256",
        "image",
        "selected_by",
        "reason"
      ],
      "additionalProperties": false
    },
    "variation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "EXPRESSION",
            "POSE"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "workflow_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "project_id",
    "asset_id",
    "base",
    "variation",
    "provider"
