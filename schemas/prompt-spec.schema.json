{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject"
  ],
  "properties": {
    "subject_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "identity_source"
      ],
      "properties": {
        "class": {
          "enum": [
            "full_character",
            "character_portrait",
            "costume_item",
            "prop",
            "environment"
          ]
        },
        "identity_source": {
          "type": "string",
          "minLength": 1
        },
        "whole_subject_required": {
          "type": "boolean"
        },
        "physically_connected_body": {
          "type": "boolean"
        },
        "mandatory_parts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "camera_view": {
          "enum": [
            "from_source",
            "front",
            "rear",
            "left",
            "right",
            "three_quarter"
          ]
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_trait",
              "relationship"
            ],
            "properties": {
              "source_trait": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "enum": [
                  "worn",
                  "carried"
                ]
              },
              "visible_count": {
                "type": "integer",
                "minimum": 1
              },
              "location": {
                "enum": [
                  "unspecified",
                  "front",
                  "rear",
                  "left",
                  "right"
                ]
              },
              "subject_side": {
                "enum": [
                  "SUBJECT_LEFT",
                  "SUBJECT_RIGHT"
                ]
              }
            }
          }
        },
        "forbidden_substitutions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focal_target",
        "source"
      ],
      "properties": {
        "focal_target": {
          "enum": [
            "full_character",
            "character_portrait",
            "costume_item",
            "prop",
            "environment"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "style_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "value_grouping": {
          "const": "large_coherent_masses"
        },
        "shadow_grouping": {
          "const": "broad_connected_shadows"
        },
        "background_texture": {
          "const": "subordinate"
        },
        "subject_texture": {
          "const": "selective_detail"
        },
        "silhouette_contrast": {
          "const": "strong"
        },
        "preserve_scene_landmarks": {
          "const": true
        }
      }
    },
    "style_contract_id": {
      "type": "string",
      "pattern": "^STYLE-[0-9]{3}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "pose": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "lighting": {
      "type": "string",
      "minLength": 1
    },
    "mood": {
      "type": "string",
      "minLength": 1
    },
    "appearance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "style": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "textInImage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aspectRatio": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    },
    "styleSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "description"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
